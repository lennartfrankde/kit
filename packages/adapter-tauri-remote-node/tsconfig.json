{
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,
		"noEmit": true,
		"noImplicitAny": true,
		"strictNullChecks": true,
		"allowSyntheticDefaultImports": true,
		"target": "es2022",
		"module": "node16",
		"moduleResolution": "node16",
		"baseUrl": ".",
		"paths": {
			"@sveltejs/kit": ["../kit/types/index"]
		}
	},
	"include": ["*.js", "src/**/*.js", "*.d.ts", "utils.js"],
	"exclude": ["files/**/*.js"]
}
